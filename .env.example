# Copy to .env.local and fill in real values. Never commit .env.local.
# Every variable listed here is read by shipped code or by lib/env.ts validation.

# --- Server-side AI ---
# Gemini API key. Server-side only, never exposed to the browser.
# Required when NODE_ENV=production; optional in development and test.
GEMINI_API_KEY=

# Model overrides. All six default to Gemini 3.6 Flash. Change any individual
# value only when that role needs a different model.
# Tutor and classifier are called by app/api/session/chat/route.ts; evaluator,
# transfer and validator are called by lib/session/evaluation.ts after the tutor
# turn to record learning evidence and independently verify generated transfers.
GEMINI_TUTOR_MODEL=gemini-3.6-flash
GEMINI_CLASSIFIER_MODEL=gemini-3.6-flash
# Independent second-pass validator for generated transfer problems. A transfer
# is not issued when this model rejects it or its output cannot be validated.
GEMINI_VALIDATOR_MODEL=gemini-3.6-flash
GEMINI_EVALUATOR_MODEL=gemini-3.6-flash
GEMINI_TRANSFER_MODEL=gemini-3.6-flash
# Multimodal model used to read a problem out of an uploaded image
# (lib/images/extraction.ts). Gemini 3.6 Flash supports image input.
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash

# Model driver. Leave unset for real Gemini calls.
# Set to `mock` to serve deterministic canned model output from
# lib/ai/mock-model.ts, which is what `npm run test:e2e` uses so the section 38
# scenarios can run without spending live API quota.
# Ignored when NODE_ENV=production: a mock tutor on a real deployment would be
# worse than an outage, because fabricated tutoring looks like the product
# working. See lib/ai/model-client.ts.
AI_MODEL_DRIVER=

# --- Logging ---
# One of: debug | info | warn | error. Defaults to info.
LOG_LEVEL=info

# --- Local emulators ---
# Set to true to point the Firebase client SDK at the local emulators.
# When true, both host variables below are required and startup fails without them.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Optional. When set alongside the flag above, Storage is pointed at the emulator too.
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=

# --- Firebase client config ---
# Not read from the environment. The client SDK is initialized from
# firebase-applet-config.json (see lib/firebase/config.ts). Change that file to
# point the app at a different Firebase project.
