{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "test": "npm run test:unit && npm run test:rules && npm run test:integration",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project thinkfirst-rules-test \"vitest run --config vitest.rules.config.mts\"",
    "test:integration": "firebase emulators:exec --only firestore --project thinkfirst-huythedeev \"vitest run --config vitest.integration.config.mts\"",
    "test:e2e": "playwright test",
    "eval": "tsx evals/run.ts",
    "seed": "node scripts/seed-demo-classroom.mjs",
    "emulators": "firebase emulators:start --project thinkfirst-huythedeev",
    "verify:workspace": "node scripts/verify-workspace-e2e.mjs",
    "verify:images": "node scripts/verify-image-input-e2e.mjs",
    "verify:safety": "node scripts/verify-safety-e2e.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.30.0",
    "mathjs": "^15.2.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.26.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.10",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
